# Copy to .env, then set mode 600.

# The domain this runs on. Point its DNS at this server first. Docker only.
DOMAIN=pictures.example.com

# Create this with the command in docs/self-hosting.md, or pnpm hash-password without Docker.
NUXT_ADMIN_PASSWORD_HASH=

# Where the database and photos live without Docker. Docker sets these itself.
# On a server, use absolute paths such as /srv/mantel/pictures.db and /srv/mantel.
NUXT_DB_PATH=./data/pictures.db
NUXT_PICTURES_DIR=./data

# Without Docker: the public address rebuild.sh checks after deploying.
# PUBLIC_URL=https://pictures.example.com
